window {
    transparency: "real";
    location: center;
    width: 600px;
    border: 2px;
    border-color: @border;
    border-radius: 8;
    background-color: @bg;
}

inputbar {
    padding: 8px;
    spacing: 8px;
    children: [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    str: " ";
    text-color: @fg-hl;
    font: "JetBrainsMono Nerd Font 14";
}

entry {
    text-color: @fg;
    placeholder-color: @fg-alt;
    placeholder: "Search";
}

listview {
    lines: 8;
    spacing: 4;
    padding: 4px;
}

element {
    padding: 6px 8px;
    text-color: @fg;
}

element selected {
    background-color: @bg-hl;
    text-color: @fg-hl;
    border-radius: 4;
}

element-icon {
    size: 22px;
    margin: 0 8px 0 0;
}

element-text {
    highlight: bold;
    highlight-color: @urgent;
}

scrollbar {
    width: 4px;
    handle-width: 4px;
    handle-color: @fg-hl;
    background-color: @bg-alt;
}

message {
    background-color: @bg-alt;
    padding: 4px;
}
